            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/reports/low-stock", "host": ["{{baseUrl}}"], "path": ["reports", "low-stock"] }
          }
        },
        {
          "name": "Warehouse Capacity Utilization",
          "request": {
