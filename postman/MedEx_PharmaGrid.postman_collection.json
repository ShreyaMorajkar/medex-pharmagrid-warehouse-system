{
  "info": {
    "_postman_id": "c71a3998-e7bf-49f3-a178-085e683b5849",
    "name": "MedEx PharmaGrid - Multi-Warehouse Pharmaceutical & Cold-Chain Management API",
    "description": "Comprehensive Postman Test Collection for Christ University CIA 3 - P11 Warehouse & Inventory Management System. Covers all 13 modules, Happy paths, Validation failures, Auth failures, RBAC authorization checks, and Business rule violations for MedEx PharmaGrid.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "managerToken", "value": "", "type": "string" },
    { "key": "staffToken", "value": "", "type": "string" },
    { "key": "warehouseIdHyd", "value": "", "type": "string" },
    { "key": "warehouseIdMaa", "value": "", "type": "string" },
    { "key": "itemIdVac", "value": "", "type": "string" },
    { "key": "itemIdAnt", "value": "", "type": "string" },
    { "key": "transferId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Authentication & RBAC",
      "item": [
        {
          "name": "Login - Admin (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token received', () => pm.expect(json.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('adminToken', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medex.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Manager (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('managerToken', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chennai.manager@medex.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Staff (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staffToken', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hyd.staff@medex.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Invalid Credentials (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is INVALID_CREDENTIALS', () => pm.expect(pm.response.json().errorCode).to.eql('INVALID_CREDENTIALS'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medex.com\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
